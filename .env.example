# Salin file ini menjadi .env.local, lalu isi token dari dashboard Syln.
SYLN_TOKEN=syln_live_ganti_dengan_token_anda
PORT=3000

# true: normalisasi unduhan agar durasinya terbaca benar di QuickTime (memerlukan FFmpeg)
# false: kirim file asli langsung dari penyedia tanpa normalisasi
DOWNLOAD_QUICKTIME_COMPAT=true
